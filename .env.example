# Copy to .env at the repo root. docker-compose reads ${VAR} from this file.
# Any var left blank here is passed into the container as an empty string, which
# python-dotenv will NOT override - see the note in README/DEPLOY.

# --- discord-bot ---
TOKEN=
PREFIX=!
DECT_API=https://an-bot-obj-dect.fly.dev/obj-dect
NTS_API=https://an-bot-nts.fly.dev/combine-NTS

# --- detection (Firebase storage) ---
FLASK_APP=app.py
API_KEY=
AUTH_DOMAIN=an-bot-obj-dect.firebaseapp.com
PROJECT_ID=an-bot-obj-dect
STORAGE_BUCKET=an-bot-obj-dect.appspot.com
MESSAGING_SENDER_ID=631283162914
APP_ID=
MEASUREMENT_ID=G-LPKDW93STP
